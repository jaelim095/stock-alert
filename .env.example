# ── 한국투자증권 오픈API ──────────────────────────────
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=12345678-01      # 계좌번호 (앞 8자리-뒤 2자리)
KIS_ENV=vps                     # vps=모의투자(먼저 이걸로 테스트), prod=실전

# ── 구글시트 ─────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/service_account.json
SHEET_ID=                       # 시트 URL의 /d/ 와 /edit 사이 문자열

# ── 카카오톡 나에게 보내기 ────────────────────────────
KAKAO_REST_API_KEY=
KAKAO_TOKENS_PATH=./data/kakao_tokens.json

# ── 이메일 (Gmail) ───────────────────────────────────
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=             # 구글 계정 > 앱 비밀번호 16자리
ALERT_EMAIL_TO=                 # 알림 받을 주소 (본인 주소)

# ── 동작 설정 ────────────────────────────────────────
POLL_INTERVAL_MIN=5             # 장중 폴링 주기(분)
DEFAULT_DROP_PCT=10             # 하락 임계 기본값(%)
DEFAULT_RISE_PCT=10             # 상승 임계 기본값(%)
REMIND_INTERVAL_HOURS=24        # 미해소 조건 리마인드 간격
ENABLE_DAY_MARKET=false         # 미국 주간거래(KST 10~16시) 감시 여부
