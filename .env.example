# ── Korea Investment & Securities Open API ───────────
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=12345678-01      # account number (first 8 digits-last 2 digits)
KIS_ENV=vps                     # vps=paper trading (test with this first), prod=live

# ── Google Sheets ────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/service_account.json
SHEET_ID=                       # the string between /d/ and /edit in the sheet URL

# ── KakaoTalk "send to me" ───────────────────────────
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=            # required only if enabled under Kakao Login > Security
KAKAO_TOKENS_PATH=./data/kakao_tokens.json

# ── Email (Gmail) ────────────────────────────────────
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=             # Google Account > App passwords, 16 characters
ALERT_EMAIL_TO=                 # address that receives alerts (your own)
ALERT_EMAIL_MODE=always         # always=always alongside KakaoTalk, fallback=only when KakaoTalk fails, off=disabled

# ── Behavior settings ────────────────────────────────
POLL_INTERVAL_MIN=5             # polling interval during market hours (minutes)
DEFAULT_DROP_PCT=10             # default drop threshold (%)
DEFAULT_RISE_PCT=10             # default rise threshold (%)
REMIND_INTERVAL_HOURS=24        # reminder interval for unresolved conditions
ENABLE_DAY_MARKET=false         # whether to watch the US day session (KST 10:00-16:00)
