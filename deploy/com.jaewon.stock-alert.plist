<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jaewon.stock-alert</string>

    <!-- caffeinate -i: 봇이 도는 동안만 맥 유휴 잠자기 방지 (sudo 불필요, 봇 종료 시 자동 해제) -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>/Users/jaewon/stock-alert/.venv/bin/python</string>
        <string>-m</string>
        <string>src.main</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jaewon/stock-alert</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>/Users/jaewon/stock-alert/logs/stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/jaewon/stock-alert/logs/stderr.log</string>
</dict>
</plist>
