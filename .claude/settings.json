{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python scripts/portfolio_snapshot.py)",
      "Bash(.venv/bin/python scripts/portfolio_snapshot.py:*)",
      "Bash(.venv/bin/pytest)",
      "Bash(.venv/bin/pytest:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-secrets.sh"
          }
        ]
      }
    ]
  }
}
